{
  "schema": "resonarch.toolfabric.tool/v1",
  "id": "test.run",
  "version": "2.0.0",
  "title": "test.run",
  "summary": "Canonical ToolFabric primitive: test.run.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "plan_id"
    ],
    "properties": {
      "plan_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "test:run",
    "process:host_execution"
  ],
  "authority_scope": [
    "workspace",
    "host_user"
  ],
  "risk_class": "R2",
  "side_effect": "local",
  "idempotency": "non_idempotent",
  "network": "optional",
  "receipt": "required",
  "default_timeout_ms": 30000,
  "max_output_bytes": 1048576
}
