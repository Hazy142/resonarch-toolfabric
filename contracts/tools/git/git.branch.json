{
  "schema": "resonarch.toolfabric.tool/v1",
  "id": "git.branch",
  "version": "2.0.0",
  "title": "git.branch",
  "summary": "Canonical ToolFabric primitive: git.branch.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name"
    ],
    "properties": {
      "repo_path": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": true
  },
  "capabilities": [
    "git:branch"
  ],
  "authority_scope": [
    "workspace"
  ],
  "risk_class": "R1",
  "side_effect": "repository",
  "idempotency": "conditional",
  "network": "forbidden",
  "receipt": "required",
  "default_timeout_ms": 30000,
  "max_output_bytes": 1048576
}
